{
  "name": "Messaging Reliability Labs",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "postCreateCommand": "pip install -r rabbitmq-lab/requirements.txt -r kafka-lab/requirements.txt",
  "forwardPorts": [15672, 8080],
  "portsAttributes": {
    "15672": { "label": "RabbitMQ management UI" },
    "8080": { "label": "Kafka UI" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"]
    }
  }
}
